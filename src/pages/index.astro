---
// Inicio. Portada (con «desde $900» y la calificación de Google), lo más importante en una cinta, el hotel en
// tres fotos, las habitaciones con su precio y sus ofertas, lo incluido, la palapa, las reseñas, el blog, el mapa
// con las distancias y las preguntas. Sin banda de «Reservar» al final: el botón de la cabecera siempre está a la vista.
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Reserva from '../components/Reserva.astro';
import Cinta from '../components/Cinta.astro';
import Ventana from '../components/Ventana.astro';
import Habitaciones from '../components/Habitaciones.astro';
import Incluido from '../components/Incluido.astro';
import Palapa from '../components/Palapa.astro';
import Resenas from '../components/Resenas.astro';
import BlogCorto from '../components/BlogCorto.astro';
import Mapa from '../components/Mapa.astro';
import Preguntas from '../components/Preguntas.astro';
import { H } from '../data/hoteles';
import { T, SEO } from '../data/textos';
const b = T.inicio.blog;
// El nombre del sitio para Google (solo va en la portada del sitio).
const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', '@id': H.sitio + '/#sitio', name: H.nombre, alternateName: H.corto, url: H.sitio + '/', inLanguage: 'es-MX', publisher: { '@id': H.sitio + '/#hotel' } }];
---
<Base title={SEO.inicio.title} description={SEO.inicio.description} schema={schema}>
  <Portada><Reserva /></Portada>
  <Cinta />
  <Ventana />
  <Habitaciones />
  <Incluido />
  <Palapa />
  <Resenas />
  <BlogCorto forma="abanico" deTema={b.tema} mini={b.mini} lineas={[b.l]} ovalo={b.o} texto={b.texto} />
  <Mapa modo="inicio" />
  <Preguntas de="inicio" />
</Base>
